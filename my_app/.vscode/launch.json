{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Masaraty (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "android"]
    },
    {
      "name": "Masaraty (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "windows"]
    },
    {
      "name": "Masaraty (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome", "--web-port=7357"],
      "preLaunchTask": "Start CORS dev proxy"
    }
  ]
}
